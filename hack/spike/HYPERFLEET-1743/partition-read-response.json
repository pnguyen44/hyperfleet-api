   "kubeContent": {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
     "name": "test-hyperfleet-api-postgresql",
     "labels": {
      "helm.sh/chart": "hyperfleet-api-1.3.0",
      "app.kubernetes.io/name": "hyperfleet-api",
      "app.kubernetes.io/instance": "test",
      "app.kubernetes.io/version": "test",
      "app.kubernetes.io/managed-by": "Helm",
      "app.kubernetes.io/component": "postgresql"
     }
    },
    "spec": {
     "replicas": 1,
     "selector": {
      "matchLabels": {
       "app.kubernetes.io/name": "hyperfleet-api",
       "app.kubernetes.io/instance": "test",
       "app.kubernetes.io/component": "postgresql"
      }
     },
     "template": {
      "metadata": {
       "labels": {
        "app.kubernetes.io/name": "hyperfleet-api",
        "app.kubernetes.io/instance": "test",
        "app.kubernetes.io/component": "postgresql"
       }
      },
      "spec": {
       "containers": [
        {
         "name": "postgresql",
         "image": "docker.io/library/postgres:14.24",
         "ports": [
          {
           "name": "postgresql",
           "containerPort": 5432,
           "protocol": "TCP"
          }
         ],
         "env": [
          {
           "name": "POSTGRES_DB",
           "value": "hyperfleet"
          },
          {
           "name": "POSTGRES_USER",
           "value": "hyperfleet"
          },
          {
           "name": "POSTGRES_PASSWORD",
           "value": "hyperfleet-dev-password"
          }
         ],
         "resources": {
          "limits": {
           "cpu": "500m",
           "memory": "512Mi"
          },
          "requests": {
           "cpu": "100m",
           "memory": "128Mi"
          }
         },
         "readinessProbe": {
          "exec": {
           "command": [
            "pg_isready",
            "-U",
            "hyperfleet",
            "-d",
            "hyperfleet"
           ]
          },
          "initialDelaySeconds": 5,
          "periodSeconds": 5
         },
         "livenessProbe": {
          "exec": {
           "command": [
            "pg_isready",
            "-U",
            "hyperfleet",
            "-d",
            "hyperfleet"
           ]
          },
          "initialDelaySeconds": 30,
          "periodSeconds": 10
         }
        }
       ]
      }
     }
    }
   }
