   "kubeContent": {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
     "name": "test-hyperfleet-api",
     "labels": {
      "helm.sh/chart": "hyperfleet-api-1.3.0",
      "app.kubernetes.io/name": "hyperfleet-api",
      "app.kubernetes.io/instance": "test",
      "app.kubernetes.io/version": "test",
      "app.kubernetes.io/managed-by": "Helm",
      "app.kubernetes.io/component": "api"
     }
    },
    "spec": {
     "replicas": 1,
     "strategy": {
      "rollingUpdate": {
       "maxSurge": 1,
       "maxUnavailable": 0
      },
      "type": "RollingUpdate"
     },
     "selector": {
      "matchLabels": {
       "app.kubernetes.io/name": "hyperfleet-api",
       "app.kubernetes.io/instance": "test",
       "app.kubernetes.io/component": "api"
      }
     },
     "template": {
      "metadata": {
       "annotations": {
        "checksum/config": "9daaf519e387200832a4854d93a7e2b46cc3a8cfd13c7b03246f3865e28666c8"
       },
       "labels": {
        "app.kubernetes.io/name": "hyperfleet-api",
        "app.kubernetes.io/instance": "test",
        "app.kubernetes.io/component": "api"
       }
      },
      "spec": {
       "serviceAccountName": "test-hyperfleet-api",
       "terminationGracePeriodSeconds": 45,
       "securityContext": {
        "fsGroup": 65532,
        "runAsNonRoot": true,
        "runAsUser": 65532
       },
       "initContainers": [
        {
         "name": "wait-for-db",
         "image": "busybox:1.36",
         "command": [
          "sh",
          "-c",
          "until nc -z test-hyperfleet-api-postgresql 5432; do echo waiting for postgresql; sleep 2; done"
         ]
        },
        {
         "name": "db-migrate",
         "image": "quay.io/openshift-hyperfleet/hyperfleet-api:test",
         "imagePullPolicy": "Always",
         "command": [
          "/app/hyperfleet-api",
          "migrate"
         ],
         "env": [
          {
           "name": "HYPERFLEET_CONFIG",
           "value": "/etc/hyperfleet/config.yaml"
          },
          {
           "name": "HYPERFLEET_DATABASE_HOST",
           "valueFrom": {
            "secretKeyRef": {
             "name": "test-hyperfleet-api-db-secrets",
             "key": "db.host"
            }
           }
          },
          {
           "name": "HYPERFLEET_DATABASE_PORT",
           "valueFrom": {
            "secretKeyRef": {
             "name": "test-hyperfleet-api-db-secrets",
             "key": "db.port"
            }
           }
          },
          {
           "name": "HYPERFLEET_DATABASE_NAME",
           "valueFrom": {
            "secretKeyRef": {
             "name": "test-hyperfleet-api-db-secrets",
             "key": "db.name"
            }
           }
          },
          {
           "name": "HYPERFLEET_DATABASE_USERNAME",
           "valueFrom": {
            "secretKeyRef": {
             "name": "test-hyperfleet-api-db-secrets",
             "key": "db.user"
            }
           }
          },
          {
           "name": "HYPERFLEET_DATABASE_PASSWORD",
           "valueFrom": {
            "secretKeyRef": {
             "name": "test-hyperfleet-api-db-secrets",
             "key": "db.password"
            }
           }
          }
         ],
         "volumeMounts": [
          {
           "name": "config",
           "mountPath": "/etc/hyperfleet",
           "readOnly": true
          }
         ]
        }
       ],
       "containers": [
        {
         "name": "hyperfleet-api",
         "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
           "drop": [
            "ALL"
           ]
          },
          "readOnlyRootFilesystem": true,
          "seccompProfile": {
           "type": "RuntimeDefault"
          }
         },
         "image": "quay.io/openshift-hyperfleet/hyperfleet-api:test",
         "imagePullPolicy": "Always",
         "workingDir": "/app",
         "args": [
          "serve"
         ],
         "ports": [
          {
           "name": "http",
           "containerPort": 8000,
           "protocol": "TCP"
          },
          {
           "name": "health",
           "containerPort": 8080,
           "protocol": "TCP"
          },
          {
           "name": "metrics",
           "containerPort": 9090,
           "protocol": "TCP"
          }
         ],
         "env": [
          {
           "name": "HYPERFLEET_CONFIG",
           "value": "/etc/hyperfleet/config.yaml"
          },
          {
           "name": "HYPERFLEET_TRACING_ENABLED",
           "value": "false"
          },
          {
           "name": "HYPERFLEET_DATABASE_HOST",
           "valueFrom": {
            "secretKeyRef": {
             "name": "test-hyperfleet-api-db-secrets",
             "key": "db.host"
            }
           }
          },
          {
           "name": "HYPERFLEET_DATABASE_PORT",
           "valueFrom": {
            "secretKeyRef": {
             "name": "test-hyperfleet-api-db-secrets",
             "key": "db.port"
            }
           }
          },
          {
           "name": "HYPERFLEET_DATABASE_NAME",
           "valueFrom": {
            "secretKeyRef": {
             "name": "test-hyperfleet-api-db-secrets",
             "key": "db.name"
            }
           }
          },
          {
           "name": "HYPERFLEET_DATABASE_USERNAME",
           "valueFrom": {
            "secretKeyRef": {
             "name": "test-hyperfleet-api-db-secrets",
             "key": "db.user"
            }
           }
          },
          {
           "name": "HYPERFLEET_DATABASE_PASSWORD",
           "valueFrom": {
            "secretKeyRef": {
             "name": "test-hyperfleet-api-db-secrets",
             "key": "db.password"
            }
           }
          }
         ],
         "livenessProbe": {
          "httpGet": {
           "path": "/healthz",
           "port": "health"
          },
          "initialDelaySeconds": 15,
          "periodSeconds": 20,
          "timeoutSeconds": 5,
          "failureThreshold": 3
         },
         "readinessProbe": {
          "httpGet": {
           "path": "/readyz",
           "port": "health"
          },
          "initialDelaySeconds": 5,
          "periodSeconds": 5,
          "timeoutSeconds": 3,
          "failureThreshold": 3
         },
         "resources": {
          "limits": {
           "cpu": "500m",
           "memory": "512Mi"
          },
          "requests": {
           "cpu": "100m",
           "memory": "128Mi"
          }
         },
         "lifecycle": {
          "preStop": {
           "exec": {
            "command": [
             "/bin/sh",
             "-c",
             "sleep 5"
            ]
           }
          }
         },
         "volumeMounts": [
          {
           "name": "config",
           "mountPath": "/etc/hyperfleet",
           "readOnly": true
          },
          {
           "name": "tmp",
           "mountPath": "/tmp"
          }
         ]
        }
       ],
       "volumes": [
        {
         "name": "config",
         "configMap": {
          "name": "test-hyperfleet-api-config"
         }
        },
        {
         "name": "tmp",
         "emptyDir": {}
        }
       ]
