sword\n      - secret\n      - token\n      - api_key\n      - access_token\n      - refresh_token\n      - client_secret\n\nmetrics:\n  host: 0.0.0.0\n  port: 9090\n\n  tls:\n    enabled: false\n\n  label_metrics_inclusion_duration: 168h\n\nhealth:\n  host: 0.0.0.0\n  port: 8080\n\n  tls:\n    enabled: false\n\n  shutdown_timeout: 20s\n  db_ping_timeout: 2s\n# NOTE: When EntityDescriptor gains many more fields, consider replacing\n# the explicit range below with: .Values.config.entities | toYaml | indent 6\nentities:\n  - kind: Cluster\n    plural: clusters\n    spec_schema_name: ClusterSpec\n    required_adapters:\n      - validation\n      - dns\n      - pullsecret\n      - hypershift\n    name_min_len: 3\n    name_max_len: 53\n    require_spec_schema: true\n  - kind: NodePool\n    plural: nodepools\n    parent_kind: Cluster\n    on_parent_delete: cascade\n    spec_schema_name: NodePoolSpec\n    required_adapters:\n      - validation\n      - hypershift\n    name_min_len: 3\n    name_max_len: 15\n    require_spec_schema: true\n  - kind: Channel\n    plural: channels\n    spec_schema_name: ChannelSpec\n  - kind: Version\n    plural: versions\n    parent_kind: Channel\n    on_parent_delete: restrict\n    spec_schema_name: VersionSpec\n    required_adapters:\n      - validation\n    references:\n      - ref_type: channel\n        target_kind: Channel\n        min: 1\n        max: 1\n  - kind: WifConfig\n    plural: wifconfigs\n    spec_schema_name: WifConfigSpec\n"
