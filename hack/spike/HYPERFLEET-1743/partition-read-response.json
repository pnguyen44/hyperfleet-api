    "data": {
     "config.yaml": "# Sentinel information\nsentinel:\n  name: \"hyperfleet-sentinel-clusters\"\n\n# Debug configuration\ndebug_config: false\n\n# Logging configuration\nlog:\n  level: \"info\"\n  format: \"json\"\n  output: \"stdout\"\n\n# Client configurations\nclients:\n  # HyperFleet API client\n  hyperfleet_api:\n    base_url: \"http://hyperfleet-api:8000\"\n    version: \"v1\"\n    timeout: \"10s\"\n\n  # Broker client\n  broker:\n    topic: \"default-clusters\"\n\n# Sentinel configuration\nresource_type: clusters\npoll_interval: 5s\n# Configurable CEL-based decision logic\nmessage_decision:\n  params:\n    - name: ref_time\n      expr: \"condition(\\\"Reconciled\\\").last_updated_time\"\n    - name: is_reconciled\n      expr: \"condition(\\\"Reconciled\\\").status == \\\"True\\\"\"\n    - name: has_ref_time\n      expr: \"ref_time != \\\"\\\"\"\n    - name: is_new_resource\n      expr: \"resource.generation == 1 && !has_ref_time\"\n    - name: generation_mismatch\n      expr: \"resource.generation > condition(\\\"Reconciled\\\").observed_generation\"\n    - name: reconciled_and_stale\n      expr: \"is_reconciled && has_ref_time && now - timestamp(ref_time) > duration(\\\"30m\\\")\"\n    - name: not_reconciled_and_debounced\n      expr: \"!is_reconciled && has_ref_time && now - timestamp(ref_time) > duration(\\\"10s\\\")\"\n  result: \"is_new_resource || generation_mismatch || reconciled_and_stale || not_reconciled_and_debounced\"\n# CloudEvents data payload configuration\nmessage_data:\n  generation: resource.generation\n  href: resource.href\n  id: resource.id\n  kind: resource.kind\n"
    }
